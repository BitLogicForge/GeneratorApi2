{
  "name": "generatorapi",
  "version": "1.0.0",
  "description": "Extensible Express API for webapp PDFs and editable PowerPoint presentations",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "precommit": "lint-staged && npm run lint:code && npm run typecheck && npm run knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "test:outputs": "tsx --test test/output-routes.ts",
    "browser:install": "playwright install chromium",
    "build": "tsc && node scripts/rewrite-imports.mjs dist",
    "build:azure": "node scripts/build-azure.mjs",
    "start:azure": "bash scripts/start-azure.sh",
    "test:azure": "tsx --test test/azure-package.ts",
    "lint:code": "oxlint --type-aware --deny-warnings src test examples scripts",
    "lint": "npm run lint:code && npm run typecheck && npm run knip && npm run format:check",
    "typecheck": "npm run check:imports && tsc -p tsconfig.check.json",
    "knip": "knip",
    "deps:verify": "npm run typecheck && npm run knip && npm run browser:install && npm test",
    "deps:update": "ncu --target semver --upgrade --doctor --doctorTest \"npm run deps:verify\"",
    "demo": "tsx examples/pdf/webapp.ts",
    "demo:data-api": "tsx --env-file-if-exists=.env examples/data-api/server/index.ts",
    "example:fetch-batch": "tsx --env-file-if-exists=.env examples/data-api/batch/fetch.ts",
    "example:fetch-chain": "tsx --env-file-if-exists=.env examples/data-api/chain/fetch.ts",
    "example:fetch-data": "tsx --env-file-if-exists=.env examples/data-api/single/fetch.ts",
    "example:fill-template": "tsx examples/pptx/fill-template.ts",
    "deps:check": "ncu --target semver",
    "check:imports": "oxlint --config .oxlint-imports.json --deny-warnings src test examples"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "playwright": "^1.64.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "es-module-lexer": "^3.0.3",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "image-size": "2.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
