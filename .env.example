HOST=0.0.0.0
PORT=3000
WEBAPP_BASE_URL=http://localhost:3001
PDF_CONCURRENCY=2
RENDER_TIMEOUT_MS=30000
PPTX_CONCURRENCY=4
QUEUE_MAX_PENDING=200
QUEUE_WAIT_TIMEOUT_MS=120000

# User login: set entra and fill tenant/API IDs to validate MSAL API access tokens.
# The API app registration must issue v2 access tokens and expose ENTRA_API_SCOPE.
AUTH_MODE=disabled
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_SCOPE=access_as_user
CORS_ALLOWED_ORIGINS=

# Optional UAMI client ID assigned to this Azure app (separate from the API client ID).
# Creates an injected ManagedIdentityCredential for downstream Azure SDK calls.
AZURE_CLIENT_ID=

# Optional external JSON data API; run npm run demo:data-api for this local example.
DATA_API_BASE_URL=http://localhost:3002/api
DATA_API_TOKEN=
DATA_API_TIMEOUT_MS=10000
