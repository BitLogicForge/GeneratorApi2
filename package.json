{
  "name": "generatorapi",
  "version": "1.0.0",
  "description": "Extensible Express API for webapp PDFs and editable PowerPoint presentations",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "browser:install": "playwright install --with-deps chromium",
    "build": "node scripts/build.mjs",
    "start:azure": "bash scripts/start-azure.sh",
    "lint:code": "oxlint --type-aware --deny-warnings src test examples scripts",
    "lint": "npm run lint:code && npm run typecheck && npm run knip && npm run format:check",
    "verify:ci": "bash scripts/verify-ci.sh",
    "typecheck": "npm run check:imports && tsc -p tsconfig.check.json",
    "knip": "knip",
    "deps:verify": "npm run typecheck && npm run knip && npm run browser:install && npm test",
    "deps:update": "ncu --target semver --upgrade --doctor --doctorTest \"npm run deps:verify\"",
    "demo": "tsx examples/pdf/webapp.ts",
    "demo:data-api": "tsx --env-file-if-exists=.env examples/data-api/server/index.ts",
    "example:fetch-batch": "tsx --env-file-if-exists=.env examples/data-api/batch/fetch.ts",
    "example:fetch-chain": "tsx --env-file-if-exists=.env examples/data-api/chain/fetch.ts",
    "example:fetch-data": "tsx --env-file-if-exists=.env examples/data-api/single/fetch.ts",
    "example:fill-template": "tsx examples/pptx/jszip/workflow.ts",
    "deps:check": "ncu --target semver",
    "check:imports": "oxlint --config .oxlint-imports.json --deny-warnings src test examples",
    "test:jszip": "tsx --test \"test/pptx/jszip/*.test.ts\"",
    "example:pptx:text": "tsx examples/pptx/jszip/text.ts",
    "example:pptx:paragraphs": "tsx examples/pptx/jszip/paragraphs.ts",
    "example:pptx:chart": "tsx examples/pptx/jszip/chart.ts",
    "example:pptx:table": "tsx examples/pptx/jszip/table.ts",
    "example:pptx:duplicate-slide": "tsx examples/pptx/jszip/duplicate-slide.ts",
    "example:pptx:remove-slide": "tsx examples/pptx/jszip/remove-slide.ts",
    "example:pptx:placeholders": "tsx examples/pptx/jszip/placeholders.ts",
    "example:pptx:brief": "tsx examples/pptx/generate-brief.ts",
    "example:data-to-pptx": "tsx --env-file-if-exists=.env examples/data-api/data-to-pptx.ts",
    "example:render-pdf": "tsx --env-file-if-exists=.env examples/pdf/render.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lru-cache": "^11.5.3",
    "playwright": "^1.64.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "knip": "^6.41.0",
    "npm-check-updates": "^23.1.1",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "image-size": "2.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
