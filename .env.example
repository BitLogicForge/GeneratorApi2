HOST=0.0.0.0
PORT=3000
WEBAPP_BASE_URL=http://localhost:3001
PDF_CONCURRENCY=2
RENDER_TIMEOUT_MS=30000
PPTX_CONCURRENCY=4
QUEUE_MAX_PENDING=200
QUEUE_WAIT_TIMEOUT_MS=120000

# User authentication scaffolding: disabled keeps the demo open. Entra mode denies access
# until src/auth/entra.ts has a real access-token verifier. Use your tenant/API IDs.
AUTH_MODE=disabled
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_SCOPE=access_as_user

# Separate identity of the Azure-hosted API for future Azure SDK calls (not user login).
# This placeholder is not consumed yet; set it to your UAMI client ID when wiring the SDK.
AZURE_CLIENT_ID=

# Optional external JSON data API; run npm run demo:data-api for this local example.
DATA_API_BASE_URL=http://localhost:3002/api
DATA_API_TOKEN=
DATA_API_TIMEOUT_MS=10000
