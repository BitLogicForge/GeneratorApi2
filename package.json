{
  "name": "generatorapi",
  "version": "1.0.0",
  "description": "Extensible Express API for webapp PDFs and editable PowerPoint presentations",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "browser:install": "playwright install chromium",
    "build": "tsc",
    "build:azure": "node scripts/build-azure.mjs",
    "start:azure": "bash scripts/start-azure.sh",
    "typecheck": "tsc -p tsconfig.check.json",
    "demo": "tsx examples/webapp.ts",
    "demo:data-api": "tsx --env-file-if-exists=.env examples/data-api.ts",
    "example:fetch-data": "tsx --env-file-if-exists=.env examples/fetch-report-data.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
