API_HOST=0.0.0.0
API_PORT=3000
WEBAPP_BASE_URL=http://localhost:3001
PDF_CONCURRENCY=2
RENDER_TIMEOUT_MS=30000
PPTX_CONCURRENCY=4
QUEUE_MAX_PENDING=200
QUEUE_WAIT_TIMEOUT_MS=120000

# When rendering SPAs on Azure Blob Storage static websites (where 404 serves index.html),
# set PDF_ALLOW_HTTP_404=true to accept HTTP 404 responses instead of failing with 502.
PDF_ALLOW_HTTP_404=false

# Suppress request completion logs for unmatched routes (e.g. Always On root pings, bot scanners)
LOG_IGNORE_UNMATCHED=false
# Optional comma-separated list of route paths to exclude from request completion logs (e.g. /health,/internal/ready)
LOG_EXCLUDE_ROUTES=

# Log webapp target URL and status for every PDF render (enabled by default)
PDF_LOG_REQUESTS=true
LOG_VERBOSE=false

# Optional external JSON data API; run npm run demo:data-api for this local example.
DATA_API_BASE_URL=http://localhost:3002/api
DATA_API_TOKEN=
DATA_API_TIMEOUT_MS=10000
# In-process validated JSON cache; TTL 0 disables caching.
DATA_API_CACHE_TTL_MS=30000
DATA_API_CACHE_MAX_ENTRIES=500
DATA_API_CACHE_MAX_BYTES=16777216
