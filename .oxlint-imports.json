{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Import TypeScript source with .ts; the compiler rewrites extensions to .js in dist."
              }
            ]
          }
        ]
      }
    }
  ]
}
